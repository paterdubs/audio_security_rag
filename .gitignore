# Dữ liệu: hàng chục GB, tải lại được từ scripts/download_sources.py
data/raw/
data/interim/
data/features/
data/synthetic/
data/banks/

# Manifest, exclusions, báo cáo phủ: NHỎ và là bản ghi quyết định → PHẢI theo dõi.
!data/manifests/
!data/reference/
!data/annotations/
!data/gold/

# NGOẠI LỆ trong data/gold/: bản sao AUDIO THẬT (make_blind_set.py copy từ
# AudioSet-strong để gán lại mù) không được redistribute — DATA_PLAN §9 cấm phát hành lại
# audio AudioSet, chỉ script tái tạo được phép commit. mapping.csv (metadata nhỏ, không
# phải audio) vẫn theo dõi bình thường vì nó KHÔNG nằm trong thư mục này.
data/gold/blind_v1_lan2/

.venv/
.venv-services/
__pycache__/
*.pyc
.pytest_cache/
.ipynb_checkpoints/
.mypy_cache/
.ruff_cache/

# Bí mật: .env chứa mật khẩu DB và API key. Chỉ .env.example được theo dõi.
.env
.env.*
!.env.example

# Frontend
services/frontend/node_modules/
services/frontend/dist/

# Model weights/checkpoints are local artifacts (GitHub rejects files >100 MB).
# Keep lightweight history/config/metrics in ml/runs/, but never commit the binaries.
*.pt
*.pth
*.ckpt
*.onnx
