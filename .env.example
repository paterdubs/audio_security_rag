# Sao chép thành .env rồi sửa. KHÔNG commit .env (đã có trong .gitignore).
#   cp .env.example .env

# ── PostgreSQL + pgvector ────────────────────────────────────────────────────
POSTGRES_USER=asr
POSTGRES_PASSWORD=doi_mat_khau_nay
POSTGRES_DB=audio_security
# Host `db` là tên service trong docker-compose, không phải localhost.
DATABASE_URL=postgresql+asyncpg://asr:doi_mat_khau_nay@db:5432/audio_security

# ── Redis (broker cho Redis Streams — W7 mới dùng tới) ───────────────────────
REDIS_URL=redis://redis:6379/0

# ── Service nội bộ ───────────────────────────────────────────────────────────
INFERENCE_URL=http://inference:8001
MLFLOW_TRACKING_URI=http://mlflow:5000

# ── Model ────────────────────────────────────────────────────────────────────
# EMBED_DIM phải khớp cột VECTOR(n) trong migration. Đổi model sang loại khác số
# chiều thì BẮT BUỘC viết migration mới — không sửa mỗi biến này.
EMBED_MODEL=BAAI/bge-m3
EMBED_DIM=1024

# ── Tầng RAG ─────────────────────────────────────────────────────────────────
# template  : trích xuất từ caption đã truy xuất, không gọi LLM ngoài (mặc định)
# anthropic : cần ANTHROPIC_API_KEY
# ollama    : cần OLLAMA_URL trỏ tới một Ollama đang chạy
RAG_ANSWER_PROVIDER=template
ANTHROPIC_API_KEY=
OLLAMA_URL=http://host.docker.internal:11434
RAG_TOP_K=5

# ── Quyền riêng tư (SYSTEM.md §1.4) ──────────────────────────────────────────
# Audio thô chỉ giữ có thời hạn. Đặt 0 để KHÔNG lưu audio, chỉ giữ metadata + caption.
AUDIO_RETENTION_DAYS=30

LOG_LEVEL=INFO
